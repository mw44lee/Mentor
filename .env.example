# 이 파일을 .env로 복사해 필요한 값만 넣으세요. .env는 GitHub에 올라가지 않습니다.
# AI는 기본으로 이 PC의 Claude Code(claude) 로그인으로 동작합니다. 아래 키는 모두 선택 사항입니다.

# 선택: Claude Code 로그인이 자주 풀리면 `claude setup-token`으로 만든 장기 토큰
CLAUDE_CODE_OAUTH_TOKEN=
# 선택: Claude Code에서 쓸 모델 (비우면 계정 기본 모델. 예: opus, sonnet)
CLAUDE_CLI_MODEL=

# 선택: Claude Code 대신 Anthropic API로 처리하려면 키 (별도 크레딧 필요)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 보고서 양식에 들어갈 멘토 이름
MENTOR_NAME=

# 선택: 접속 링크 메일 (Gmail 앱 비밀번호). 다른 .env의 값을 쓰려면 MAIL_ENV_FALLBACK에 그 파일 경로
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_ENV_FALLBACK=

# 선택: 녹음 자동 받아쓰기 (없으면 텍스트 변환본을 올림)
OPENAI_API_KEY=

# 데이터 폴더 (기본: 앱 폴더의 상위 폴더/data)
MENTOR_DATA_DIR=
# 접속 주소: 127.0.0.1 유지 (외부 접속은 Tailscale serve로)
HOST=127.0.0.1
PORT=8770
